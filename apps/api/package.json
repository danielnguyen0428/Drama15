{
  "name": "@drama15/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drama15 Lite SaaS backend (Fastify + TypeScript). Hosts API_Gateway, Auth_Service, License_Service, Rate_Limiter, Audit_Logger, and Export_Service.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "node scripts/check-port.mjs && tsx watch src/startDev.ts",
    "dev:prod": "node scripts/check-port.mjs && tsx watch src/start.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/start.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "@drama15/contracts": "file:../../packages/contracts",
    "@fastify/static": "^9.1.3",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.4.1",
    "jszip": "^3.10.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@drama15/test-helpers": "file:../../packages/test-helpers",
    "@types/node": "^20.14.10",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "dotenv": "^17.4.2",
    "fast-check": "^4.8.0",
    "pdf-parse": "^1.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
