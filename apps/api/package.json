{
  "name": "@drama15/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Drama15 writing API.",
  "scripts": {
    "dev": "node scripts/check-port.mjs && tsx watch src/startDev.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/startDev.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:stream-headers": "tsx --test src/streamHeaders.test.ts",
    "test:story-quota-migration": "tsx --test src/storyQuotaMigration.test.ts",
    "test:setup-suggestion-quota-route": "tsx --test src/setupSuggestionQuotaRoute.test.ts",
    "test:orchestrator-progress": "tsx --test src/orchestratorProgressEncoding.test.ts",
    "test:quota": "tsx --test src/quota.test.ts",
    "test:quota-copy": "tsx --test src/quotaCopy.test.ts",
    "test:relationship-graph": "tsx --test src/relationshipGraph.test.ts",
    "test:seed-blueprint": "tsx --test src/seedBlueprintFictionMeSignals.test.ts",
    "test:story-title": "tsx --test src/storyTitleResolution.test.ts",
    "test:style-blueprints": "tsx --test src/styleBlueprintPresets.test.ts",
    "test:web-csp": "tsx --test src/webCsp.test.ts",
    "test:concept-name-alignment": "tsx --test src/conceptNameAlignment.test.ts",
    "test:structural-slop": "tsx --test src/structuralSlop.test.ts",
    "test:reader-panel": "tsx --test src/readerPanel.test.ts",
    "test:manuscript-review": "tsx --test src/manuscriptReview.test.ts",
    "test:adversarial-cut": "tsx --test src/adversarialCut.test.ts",
    "test:revision-planner": "tsx --test src/revisionPlanner.test.ts",
    "test:voice-fingerprint": "tsx --test src/voiceFingerprint.test.ts",
    "test:propagation-ledger": "tsx --test src/propagationLedger.test.ts",
    "test:foundation-gate": "tsx --test src/foundationGate.test.ts",
    "test:canon-facts": "tsx --test src/canonFacts.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "jsonrepair": "3.11.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
