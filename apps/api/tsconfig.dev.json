{
    "include":  [
                    "src/**/*.ts"
                ],
    "exclude":  [
                    "node_modules"
                ],
    "compilerOptions":  {
                            "noEmit":  false,
                            "outDir":  "dist",
                            "forceConsistentCasingInFileNames":  false,
                            "declaration":  false,
                            "module":  "ESNext",
                            "moduleResolution":  "bundler",
                            "isolatedModules":  true,
                            "rootDir":  "src",
                            "allowJs":  true,
                            "declarationMap":  false,
                            "target":  "ES2022",
                            "checkJs":  false,
                            "noUncheckedIndexedAccess":  false,
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "sourceMap":  false
                        }
}
