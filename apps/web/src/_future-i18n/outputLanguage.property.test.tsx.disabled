/**
 * Property test for output-language pass-through and independence
 * from the UI locale.
 *
 * **Property 26: Output language pass-through và độc lập với UI locale**
 *
 * **Validates: Requirements 6.12, 19.2, 19.3**
 *
 * For every random sequence of operations on the two stores
 *   - `setOutputLanguage('vi' | 'en')`
 *   - `setUiLocale('vi' | 'en')`  (i.e. the i18n `ui_locale` store)
 *
 * the following invariants MUST hold AFTER EVERY step:
 *
 *   (P26.a) `getOutputLanguage()` equals the most recent argument
 *           passed to `setOutputLanguage(...)` in the sequence, or the
 *           {@link DEFAULT_OUTPUT_LANGUAGE} when no `setOutputLanguage`
 *           call has happened yet.  → Requirement 6.12, 19.3
 *
 *   (P26.b) Calling `setUiLocale(...)` does NOT change the value
 *           returned by `getOutputLanguage()`. The two preferences are
 *           persisted under two distinct localStorage keys
 *           (`output_language` vs `ui_locale`) and updates to one
 *           must not mutate the other. → Requirement 19.3
 *
 *   (P26.c) `withOutputLanguage(payload).outputLanguage` always equals
 *           `getOutputLanguage()` at the time of the call. The request
 *           payload carries the user-chosen output language and is
 *           never derived from the UI locale. → Requirement 6.12
 *
 * Operations are generated with `fc.oneof` and assembled into arrays
 * of arbitrary length via `fc.array`. The test runs at `numRuns: 100`
 * (codebase default for non-state-machine properties; see
 * `design.md` → Testing Strategy → Property tests).
 *
 * The property test is intentionally framework-agnostic: it never
 * mounts a React tree because Property 26 lives below the rendering
 * layer (it is a property of the persistence + payload-shaping
 * helpers). Unit tests in `outputLanguage.test.tsx` already cover the
 * `<OutputLanguagePicker>` UI surface for the four explicit
 * `(uiLocale, outputLanguage)` combinations.
 */

import { afterEach, beforeEach, describe, expect, it } from 'vitest';
import * as fc from 'fast-check';

import { LOCALE_STORAGE_KEY } from '../../i18n/types';
import {
  DEFAULT_OUTPUT_LANGUAGE,
  OUTPUT_LANGUAGE_STORAGE_KEY,
  getOutputLanguage,
  setOutputLanguage,
  withOutputLanguage,
  type OutputLanguage,
} from '../outputLanguage';

/** UI locale alphabet — same shape as `OutputLanguage` but a separate type. */
type UiLocale = 'vi' | 'en';

/**
 * Set the UI locale through the public persistence layer of the i18n
 * module — i.e. the same `localStorage` key the `LocaleProvider` reads
 * on boot. We deliberately do NOT call `LocaleProvider.setLocale`
 * here: that helper also fires a network request which is irrelevant
 * to Property 26 and would just add jsdom/fetch noise. Writing the
 * key directly is the closest model of "user changed the UI locale".
 */
function setUiLocale(locale: UiLocale): void {
  window.localStorage.setItem(LOCALE_STORAGE_KEY, locale);
}

function getUiLocaleRaw(): string | null {
  return window.localStorage.getItem(LOCALE_STORAGE_KEY);
}

/** Discriminated union of the operations the property explores. */
type Op =
  | { kind: 'setOutput'; lang: OutputLanguage }
  | { kind: 'setUi'; lang: UiLocale };

/** Arbitrary covering both operation kinds with both language values. */
const arbOp: fc.Arbitrary<Op> = fc.oneof(
  fc
    .constantFrom<OutputLanguage>('vi', 'en')
    .map((lang) => ({ kind: 'setOutput', lang }) as const),
  fc
    .constantFrom<UiLocale>('vi', 'en')
    .map((lang) => ({ kind: 'setUi', lang }) as const),
);

/**
 * The reference model: the most-recently-set output language, or the
 * default when no `setOutputLanguage` call has been made yet. The
 * property asserts that `getOutputLanguage()` equals this model after
 * every step.
 */
function expectedOutputLang(history: ReadonlyArray<Op>): OutputLanguage {
  for (let i = history.length - 1; i >= 0; i -= 1) {
    const op = history[i];
    if (op && op.kind === 'setOutput') {
      return op.lang;
    }
  }
  return DEFAULT_OUTPUT_LANGUAGE;
}

describe('Property 26: outputLanguage is independent of ui_locale', () => {
  beforeEach(() => {
    window.localStorage.clear();
  });

  afterEach(() => {
    window.localStorage.clear();
  });

  it('preserves outputLanguage = last setOutputLanguage(...) (or default) across arbitrary op sequences', () => {
    fc.assert(
      fc.property(fc.array(arbOp, { maxLength: 30 }), (ops) => {
        // Each fast-check run starts from a clean storage snapshot so
        // the model reflects "no preference set yet".
        window.localStorage.clear();

        const history: Op[] = [];

        for (const op of ops) {
          // Snapshot the output language BEFORE the op so we can
          // verify (P26.b): a `setUi` op never moves it.
          const beforeOutput = getOutputLanguage();

          if (op.kind === 'setOutput') {
            setOutputLanguage(op.lang);
          } else {
            setUiLocale(op.lang);
          }
          history.push(op);

          // (P26.a) getOutputLanguage equals the last setOutput arg
          // or the default when the sequence so far contains none.
          const expected = expectedOutputLang(history);
          expect(getOutputLanguage()).toBe(expected);

          // (P26.b) Setting ui_locale must NOT mutate the output
          // language. We compare against the pre-op snapshot rather
          // than the model so that a `setOutput` op is allowed to
          // change it (and `setUi` is not).
          if (op.kind === 'setUi') {
            expect(getOutputLanguage()).toBe(beforeOutput);
            // The ui_locale key DOES reflect the new value, proving
            // the `setUi` call landed somewhere — the point is that
            // it landed in a different bucket from outputLanguage.
            expect(getUiLocaleRaw()).toBe(op.lang);
          }

          // (P26.c) withOutputLanguage(payload).outputLanguage tracks
          // getOutputLanguage() exactly. The payload pass-through
          // helper must never read from `ui_locale`.
          const stamped = withOutputLanguage({ probe: 1 });
          expect(stamped.outputLanguage).toBe(expected);
          // Existing payload fields survive untouched.
          expect(stamped.probe).toBe(1);
        }

        // Sanity post-condition: at the end of the sequence, the two
        // stores live under DISTINCT localStorage keys. The output
        // language store is either absent (no setOutput op) or set to
        // the model value; the ui_locale store is either absent (no
        // setUi op) or set to the most recent setUi value. Reading
        // either one never falls through to the other.
        const lastSetUi = [...ops].reverse().find((o) => o.kind === 'setUi');
        const lastSetOutput = [...ops]
          .reverse()
          .find((o) => o.kind === 'setOutput');
        expect(getUiLocaleRaw()).toBe(lastSetUi ? lastSetUi.lang : null);
        expect(window.localStorage.getItem(OUTPUT_LANGUAGE_STORAGE_KEY)).toBe(
          lastSetOutput ? lastSetOutput.lang : null,
        );
      }),
      { numRuns: 100 },
    );
  });
});
