# Drama15 API
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5174,https://drama.novelkit.cc

# OpenAI-compatible router. 9router local default:
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=dummy
MODEL_PRESET=default

# Chapter prose post-process humanizer: a second full-length model pass per
# chapter. Improves prose but roughly doubles per-chapter latency. Off by
# default; set to true only if you accept the slower generation.
CHAPTER_POST_PROCESS_ENABLED=false

ROUTER_DEFAULT_TIMEOUT_MS=300000
ROUTER_PLANNING_TIMEOUT_MS=240000
ROUTER_CHAPTER_TIMEOUT_MS=600000
ROUTER_MAX_RETRIES=2
ROUTER_FALLBACK_ENABLED=true

DEFAULT_LINE_PRESET=billionaire_rich_poor_romance
DEFAULT_STYLE_PRESET=co_man_warm_modern_blueprint
DEFAULT_CHAPTER_COUNT=15
WRITE_EXPORT_FILES=false
OUTPUT_DIR=local-output

# Supabase Auth + Postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_API_KEY=change-me

# Web build
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Telegram status bot
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Chat/group ID to receive notifications (message.chat.id from getUpdates).
TELEGRAM_CHAT_ID=
# Set to false to disable the command-polling loop (/status, /ping).
TELEGRAM_ENABLE_POLLING=true
# Optional periodic status broadcast in ms (0 = disabled). e.g. 3600000 = hourly.
TELEGRAM_STATUS_INTERVAL_MS=0
# Public web URL the bot pings for the "Web" status check.
WEB_PUBLIC_URL=https://drama.novelkit.cc
