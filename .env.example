PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=dummy
ROUTER_DEFAULT_TIMEOUT_MS=300000
ROUTER_PLANNING_TIMEOUT_MS=240000
ROUTER_CHAPTER_TIMEOUT_MS=600000
ROUTER_MAX_RETRIES=2
ROUTER_FALLBACK_ENABLED=true

OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_API_KEY=
POSTER_IMAGE_MODEL=gpt-image-2
POSTER_IMAGE_SIZE=1536x1024
POSTER_IMAGE_QUALITY=high
POSTER_IMAGE_TIMEOUT_MS=300000
POSTER_IMAGE_ENABLED=true

DEFAULT_LINE_PRESET=billionaire_rich_poor_romance
DEFAULT_STYLE_PRESET=billionaire_rich_poor_romance__tiktok_hook_pacing
DEFAULT_CHAPTER_COUNT=15
OUTPUT_DIR=./outputs
WRITE_EXPORT_FILES=false
MODEL_PRESET=default
