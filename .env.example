# Drama15 API
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5174,https://drama.novelkit.cc

# OpenAI-compatible provider (C-PROVIDER / api.xah.io). Server-managed key for
# free Deepseek 4 Flash; users may supply their own key in LLM settings instead.
OPENAI_BASE_URL=https://api.xah.io/v1
OPENAI_API_KEY=sk-your-api-key
MANAGED_C_PROVIDER_MODEL=tanynguyen97/deepseek-v4-flash [cheap]
MODEL_PRESET=default

# Per-user LLM settings. Required before enabling /llm/settings in production.
# Keep this value stable; rotate stored user keys with a decrypt/re-encrypt job.
LLM_SETTINGS_ENCRYPTION_KEY=change-me-long-random-secret
# Optional comma-separated allowlist for OTHER provider hosts.
# e.g. LLM_ALLOWED_HOSTS=api.tuongtacfree.vn
LLM_ALLOWED_HOSTS=
LLM_ALLOW_INSECURE_LOCALHOST=false

# Per-tier model presets (files in presets/models/). Lets each membership tier
# use a different model on the same provider.
MODEL_PRESET_FREE=free
MODEL_PRESET_PRO=pro
MODEL_PRESET_PREMIUM=premium

# Fast model for auxiliary analysis (character fact extraction / consistency).
# Must be a model the configured provider serves.
AUXILIARY_ANALYSIS_MODEL=tanynguyen97/deepseek-v4-flash [cheap]

# Chapter prose post-process humanizer: a second full-length model pass per
# chapter. Improves prose but roughly doubles per-chapter latency. Off by
# default; set to true only if you accept the slower generation.
CHAPTER_POST_PROCESS_ENABLED=false

# ─── autonovel upgrades (opt-in; each adds extra LLM calls) ──────────────────
# Adversarial cut: per-chapter tightening pass that trims flab without losing
# plot. Adds one model call per chapter. Off by default.
ADVERSARIAL_CUT_ENABLED=false
# Fraction of words the cut pass aims to remove (0.05-0.30).
ADVERSARIAL_CUT_TARGET_RATIO=0.12
# Reader panel: one full-manuscript LLM pass at the end that role-plays target
# readers and scores the story. Diagnostic only (stored in meta.readerPanel).
READER_PANEL_ENABLED=false
# Manuscript review: one full-manuscript LLM pass (literary critic + fiction
# professor) listing actionable issues. Diagnostic only (meta.manuscriptReview).
MANUSCRIPT_REVIEW_ENABLED=false
# Revision loop: after the reader panel / review run, automatically rewrite the
# highest-severity chapters from their feedback (needs the panel/review on).
# Adds one model call per revised chapter. Off by default.
REVISION_LOOP_ENABLED=false
# Max chapters the revision loop will rewrite in one pass (1-15).
REVISION_MAX_CHAPTERS=3
# Voice lock: inject a prose-voice profile from earlier chapters into later
# chapter prompts to keep the register consistent. Prompt-only (no extra LLM
# call), so it defaults ON. Set to false to disable.
VOICE_LOCK_ENABLED=true
# Propagation ledger: flag unpaid foreshadow / unachieved beats / late hard
# facts in meta.propagationDebt. Prompt-free analysis, defaults ON.
PROPAGATION_LEDGER_ENABLED=true
# Foundation gate: score concept+bible+plan before drafting; if below the min
# score, rebuild the outline up to MAX_ATTEMPTS times and keep the best.
# Adds 1 LLM scoring call per attempt (+ a full outline rebuild on regen). Off
# by default.
FOUNDATION_GATE_ENABLED=false
FOUNDATION_GATE_MIN_SCORE=7
FOUNDATION_GATE_MAX_ATTEMPTS=2
# Canon facts: lock hard facts at outline time and inject them into every
# chapter so the draft can't contradict them. Adds 1 LLM call per story. Off
# by default.
CANON_FACTS_ENABLED=false

ROUTER_DEFAULT_TIMEOUT_MS=300000
ROUTER_PLANNING_TIMEOUT_MS=240000
ROUTER_CHAPTER_TIMEOUT_MS=600000
ROUTER_MAX_RETRIES=2
ROUTER_FALLBACK_ENABLED=true

DEFAULT_LINE_PRESET=billionaire_rich_poor_romance
DEFAULT_STYLE_PRESET=co_man_warm_modern_blueprint
DEFAULT_CHAPTER_COUNT=15
WRITE_EXPORT_FILES=false
OUTPUT_DIR=local-output

# Supabase Auth + Postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_API_KEY=change-me

# Public read-only API for partner sites (e.g. studio.novelkit.cc).
# Callers must send this key via the x-api-key header. Leave empty to disable
# the public /public/stories endpoints. PUBLIC_API_ORIGINS is a comma-separated
# allow-list of browser origins permitted to call these endpoints.
PUBLIC_API_KEY=
PUBLIC_API_ORIGINS=https://studio.novelkit.cc

# Web build
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Telegram status bot
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Chat/group ID to receive notifications (message.chat.id from getUpdates).
TELEGRAM_CHAT_ID=
# Set to false to disable the command-polling loop (/status, /ping).
TELEGRAM_ENABLE_POLLING=true
# Optional periodic status broadcast in ms (0 = disabled). e.g. 3600000 = hourly.
TELEGRAM_STATUS_INTERVAL_MS=0
# Public web URL the bot pings for the "Web" status check.
WEB_PUBLIC_URL=https://drama.novelkit.cc
